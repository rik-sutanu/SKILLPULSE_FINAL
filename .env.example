# ==============================================================================
# SkillPulse Environment Configuration
# ==============================================================================
# WARNING: Do not commit sensitive SMTP passwords, API keys, or database credentials.

# ------------------------------------------------------------------------------
# 1. Supabase Database ('skill-pulse') Configuration
# ------------------------------------------------------------------------------
# In your Supabase Project Settings -> API:
# SUPABASE_URL: Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_ANON_KEY: Project API Key (anon/public)
SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE_SERVICE_ROLE_KEY: Service Role Key (secret - only for backend API bypass)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Tawk.to Live Chat Widget Configuration
# ------------------------------------------------------------------------------
# Obtain from your Tawk.to Dashboard -> Administration -> Property Settings / Chat Widget
TAWKTO_PROPERTY_ID=your-tawkto-property-id
TAWKTO_WIDGET_ID=default

# ------------------------------------------------------------------------------
# 3. Transactional Mailer (PHPMailer with SMTP)
# ------------------------------------------------------------------------------
# For Gmail, generate a 16-character App Password via Google Account -> Security -> App Passwords.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="SkillPulse"
